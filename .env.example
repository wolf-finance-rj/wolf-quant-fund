# Exemplo. Não insira segredos reais neste arquivo.
# Copie para .env (não versionado) e ajuste se necessário.
WQF_ENV=development

# Caminho dos dados para execução local com uv.
# No Docker o caminho é sempre /app/data (o diretório ./data é montado lá).
WQF_DATA_DIR=./data

# Jupyter via Docker Compose (opcional).
WQF_JUPYTER_PORT=8888
WQF_JUPYTER_TOKEN=wqf
